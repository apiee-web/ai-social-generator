# Rename this file to ".env" (same folder as server.cjs) and fill in your key.
# Never commit .env — it holds a secret. On Vercel you don't use this file at
# all: put the variables in Settings → Environment Variables instead.

# --- AI provider (server-side only; never expose it in the React app) ---
# Groq is the simplest option: paste a gsk_... key and stop here. The base URL
# and a current model are filled in automatically (openai/gpt-oss-20b).
AI_API_KEY=gsk-replace-me
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b

# Any other OpenAI-compatible provider: uncomment all three.
# AI_API_KEY=sk-replace-me
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Server (local development only) ---
PORT=8787
# Only needed if the browser calls the API from a different port (e.g. Vite on 5173)
ALLOW_ORIGIN=http://localhost:5173

# --- Payments (optional; leave blank for demo checkout) ---
STRIPE_SECRET_KEY=
