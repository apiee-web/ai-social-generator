# --- AI ---------------------------------------------------------------------
# Groq (free tier): https://console.groq.com/keys
# The gsk_ prefix is enough — the base URL and a current model are picked for you.
AI_API_KEY=gsk_your_key_here
# Optional, any OpenAI-compatible provider:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Accounts & credits -----------------------------------------------------
# Postgres connection string (Neon, Supabase, Railway, plain Postgres).
# Without it the app runs in guest mode: credits live in the browser and there
# are no accounts. With it, credits are stored on the server per email.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the login cookie. Any long random string (openssl rand -base64 32).
# Without it sign-in returns 503 instead of issuing a guessable session.
SESSION_SECRET=

# --- Payments (Stripe) ------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_… or sk_test_…).
# Without it "Buy credits" explains that cards aren't switched on yet.
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint pointing at
# https://your-site.vercel.app/api/stripe/webhook  (starts with whsec_).
# This is what actually credits an account after a payment.
STRIPE_WEBHOOK_SECRET=

# Public address of the site, used for Stripe's "back to the site" links.
APP_URL=https://your-app.vercel.app
